# PostgreSQL su cloud svizzero (Infomaniak / Exoscale)
DATABASE_URL=postgres://user:password@host:5432/referral_flow
# Segreto per firmare le sessioni: genera con `openssl rand -base64 32`
SESSION_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# URL pubblico dell'app (serve per i link del portale nelle notifiche).
APP_BASE_URL=http://localhost:3000

# SMTP per l'avviso neutro all'inviante (nessun dato clinico nella mail).
# Lascia vuoto SMTP_HOST per registrare le notifiche senza inviarle.
# In produzione: puntare al gateway SMTP di HIN per viaggiare sulla rete sicura.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@studio.ch
# Email della segreteria per l'avviso "nuova richiesta in arrivo".
# Fallback: la piattaforma usa prima studios.notify_email dello studio destinatario.
STUDIO_NOTIFY_EMAIL=

# Assistenza 24/7 mostrata nel menu profilo e nella pagina di login (vuoto = nascosto).
SUPPORT_PHONE=
SUPPORT_EMAIL=

# SMS di promemoria al paziente (eCall REST v2, autenticazione Basic).
# SMS_API_TOKEN = "utente:password" dell'utente API creato nel portale eCall
# (Interfacce → Panoramica → abilita REST → crea utente API). Vuoto = solo registrati.
SMS_API_URL=https://rest.ecall.ch/api/v2/message
SMS_API_TOKEN=
SMS_FROM=Studio
# Chiave del motore promemoria: /api/reminders/run?key=... (chiamato dal cron).
REMINDER_SECRET=cambia-questa-chiave

# Object storage svizzero S3-compatibile (Exoscale SOS / Infomaniak Swiss Backup).
# Lascia vuoto per salvare gli allegati in ./uploads durante lo sviluppo.
S3_ENDPOINT=
S3_REGION=ch-dk-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Cifratura at-rest (SSE) sugli upload: AES256 per attivarla, vuoto per disattivarla.
S3_SSE=AES256

# Titolare della piattaforma: abilita il pannello /piattaforma per questa email
PLATFORM_OWNER_EMAIL=
